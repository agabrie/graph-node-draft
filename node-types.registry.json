{
  "registryVersion": "1.0.0",
  "$comment": "The only place domain vocabulary is allowed to appear. Grep the editor package for 'scene', 'act', 'split', 'flowchart' or 'participant' — zero hits, or semantics have leaked out of this file.",
  "$comment-portability": "`component` and `icon` are the only framework-facing fields here, and both are OPAQUE KEYS, not imports. The frontend owns a binding map from key to whatever it renders with: Vue `{ StorySceneNode: defineAsyncComponent(...) }`, React `{ StorySceneNode: StoryScene }`, Svelte, or a native widget factory. Nothing else in this file, in graph-document.schema.json, or in examples.json is coupled to a rendering technology. If you will run more than one frontend against the same registry, move these two fields into a sibling `renderers: { vue: {...}, react: {...} }` map keyed by type; with a single frontend, leaving them inline is fine.",

  "rulesets": {
    "flowchart": {
      "invariants": ["INV-5"],
      "allowedTypes": ["flow.*", "core.*"],
      "defaultNodeType": "flow.process",
      "defaultEdgeType": "flow.link"
    },
    "sequence": {
      "invariants": ["INV-9"],
      "allowedTypes": ["seq.*", "core.group"],
      "defaultNodeType": "seq.participant",
      "defaultEdgeType": "seq.message",
      "$comment": "INV-5 deliberately absent: messages inside an alt block connect top-level participants, so edges are not level-local here."
    },
    "er": {
      "invariants": ["INV-10"],
      "allowedTypes": ["er.*", "core.group"],
      "defaultNodeType": "er.entity",
      "defaultEdgeType": "er.relationship"
    },
    "story": {
      "invariants": ["INV-5"],
      "allowedTypes": ["story.*", "core.*"],
      "defaultNodeType": "story.scene",
      "defaultEdgeType": "core.link"
    },
    "generic": {
      "invariants": [],
      "allowedTypes": ["*"],
      "defaultNodeType": "core.node",
      "defaultEdgeType": "core.link"
    }
  },

  "nodeTypes": {

    "core.node": {
      "abstract": true,
      "label": "Node",
      "category": "core",
      "component": "GenericNode",
      "allowsChildren": true,
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": null } }
      },
      "dataSchema": { "type": "object" }
    },

    "core.group": {
      "extends": "core.node",
      "label": "Group",
      "category": "core",
      "component": "GroupNode",
      "icon": "frame",
      "allowsChildren": true,
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": null } }
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "layout": {
            "type": "object",
            "properties": {
              "direction": { "type": "string", "enum": ["TB", "TD", "BT", "LR", "RL"] }
            }
          }
        }
      },
      "mermaid": { "flowchart": { "construct": "subgraph" } }
    },

    "core.portal": {
      "extends": "core.node",
      "label": "Portal",
      "category": "core",
      "component": "PortalNode",
      "icon": "arrow-right-circle",
      "allowsChildren": false,
      "$comment": "Binds an interior endpoint to a port on its own parent, so no edge ever crosses a containment boundary (INV-5). Created by the importer during normalisation; optionally user-creatable.",
      "ports": {
        "link": { "direction": "inout", "role": "portal", "arity": { "min": 0, "max": 1 } }
      },
      "dataSchema": {
        "type": "object",
        "required": ["port", "direction"],
        "properties": {
          "port": { "type": "string", "description": "Port id on the parent node that this portal binds to." },
          "direction": { "type": "string", "enum": ["in", "out"] }
        }
      }
    },

    "core.branch": {
      "extends": "core.node",
      "label": "Branch",
      "category": "core",
      "component": "BranchNode",
      "icon": "git-branch",
      "allowsChildren": true,
      "$comment": "Inserted automatically when a user connects a second edge to an out-port whose arity.max is 1. Because allowsChildren is true it is already a subgraph the moment it is expanded — no conversion step, no id churn.",
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 1, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": null }, "group": true }
      },
      "dataSchema": {
        "type": "object",
        "properties": { "condition": { "type": "string" } }
      }
    },

    "core.link": {
      "edge": true,
      "label": "Link",
      "category": "core",
      "style": { "line": "solid", "arrowEnd": "arrow" },
      "dataSchema": { "type": "object" }
    },

    "flow.process": {
      "extends": "core.node",
      "label": "Process",
      "category": "flowchart",
      "component": "FlowProcessNode",
      "icon": "square",
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": 1 } }
      },
      "mermaid": { "flowchart": { "open": "[", "close": "]" } }
    },

    "flow.rounded": {
      "extends": "flow.process",
      "label": "Rounded process",
      "category": "flowchart",
      "mermaid": { "flowchart": { "open": "(", "close": ")" } }
    },

    "flow.terminal": {
      "extends": "core.node",
      "label": "Terminal",
      "category": "flowchart",
      "component": "FlowTerminalNode",
      "icon": "circle",
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": 1 } }
      },
      "mermaid": { "flowchart": { "open": "([", "close": "])" } }
    },

    "flow.decision": {
      "extends": "core.node",
      "label": "Decision",
      "category": "flowchart",
      "component": "FlowDecisionNode",
      "icon": "diamond",
      "ports": {
        "in":    { "direction": "in",  "arity": { "min": 1, "max": null } },
        "true":  { "direction": "out", "role": "true",  "arity": { "min": 0, "max": 1 } },
        "false": { "direction": "out", "role": "false", "arity": { "min": 0, "max": 1 } }
      },
      "dataSchema": {
        "type": "object",
        "properties": { "expression": { "type": "string" } }
      },
      "mermaid": { "flowchart": { "open": "{", "close": "}" } }
    },

    "flow.datastore": {
      "extends": "core.node",
      "label": "Datastore",
      "category": "flowchart",
      "component": "FlowDatastoreNode",
      "icon": "database",
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": null } }
      },
      "mermaid": { "flowchart": { "open": "[(", "close": ")]" } }
    },

    "flow.subroutine": {
      "extends": "flow.process",
      "label": "Subroutine",
      "category": "flowchart",
      "icon": "box-multiple",
      "mermaid": { "flowchart": { "open": "[[", "close": "]]" } }
    },

    "flow.io": {
      "extends": "flow.process",
      "label": "Input / output",
      "category": "flowchart",
      "icon": "parallelogram",
      "mermaid": { "flowchart": { "open": "[/", "close": "/]" } }
    },

    "flow.link": {
      "edge": true,
      "label": "Link",
      "category": "flowchart",
      "style": { "line": "solid", "arrowEnd": "arrow" },
      "dataSchema": { "type": "object" }
    },

    "seq.participant": {
      "extends": "core.node",
      "label": "Participant",
      "category": "sequence",
      "component": "SeqParticipantNode",
      "icon": "layout-columns",
      "allowsChildren": false,
      "ports": {
        "lane": { "direction": "inout", "arity": { "min": 0, "max": null } }
      },
      "dataSchema": {
        "type": "object",
        "properties": { "isActor": { "type": "boolean", "default": false } }
      },
      "mermaid": { "sequenceDiagram": { "construct": "participant" } }
    },

    "seq.actor": {
      "extends": "seq.participant",
      "label": "Actor",
      "category": "sequence",
      "icon": "user",
      "mermaid": { "sequenceDiagram": { "construct": "actor" } }
    },

    "seq.block": {
      "extends": "core.group",
      "label": "Block",
      "category": "sequence",
      "component": "SeqBlockNode",
      "allowsChildren": true,
      "$comment": "Children are edges, not nodes. Needed no new machinery because containment is uniform across both collections.",
      "dataSchema": {
        "type": "object",
        "required": ["blockType"],
        "properties": {
          "blockType": {
            "type": "string",
            "enum": ["alt", "opt", "loop", "par", "critical", "break", "rect"]
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "edgeIds": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      },
      "mermaid": { "sequenceDiagram": { "construct": "block" } }
    },

    "seq.note": {
      "extends": "core.node",
      "label": "Note",
      "category": "sequence",
      "component": "SeqNoteNode",
      "allowsChildren": false,
      "ports": {},
      "dataSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "placement": { "type": "string", "enum": ["left", "right", "over"] },
          "anchors": { "type": "array", "items": { "type": "string" }, "maxItems": 2 }
        }
      },
      "mermaid": { "sequenceDiagram": { "construct": "note" } }
    },

    "seq.message": {
      "edge": true,
      "label": "Message",
      "category": "sequence",
      "style": { "line": "solid", "arrowEnd": "arrow" },
      "dataSchema": {
        "type": "object",
        "properties": {
          "activate": { "type": "boolean", "default": false },
          "deactivate": { "type": "boolean", "default": false }
        }
      },
      "mermaid": { "sequenceDiagram": { "construct": "message" } }
    },

    "er.entity": {
      "extends": "core.node",
      "label": "Entity",
      "category": "er",
      "component": "ErEntityNode",
      "icon": "table",
      "allowsChildren": false,
      "$comment": "Attributes live in data, not as child nodes, because they are not independently connectable. To wire FK to PK later, generate one instance port per attribute — data.attributes stays the source of truth, ports become the connection surface, no schema change needed.",
      "ports": {
        "rel": { "direction": "inout", "arity": { "min": 0, "max": null } }
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "keys": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["PK", "FK", "UK"] }
                },
                "comment": { "type": "string" }
              }
            }
          }
        }
      },
      "mermaid": { "erDiagram": { "construct": "entity" } }
    },

    "er.relationship": {
      "edge": true,
      "label": "Relationship",
      "category": "er",
      "style": { "line": "solid", "arrowEnd": "none" },
      "dataSchema": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "object",
            "required": ["cardinality"],
            "properties": {
              "cardinality": {
                "type": "string",
                "enum": ["one", "zeroOrOne", "zeroOrMany", "oneOrMany"]
              }
            }
          },
          "to": {
            "type": "object",
            "required": ["cardinality"],
            "properties": {
              "cardinality": {
                "type": "string",
                "enum": ["one", "zeroOrOne", "zeroOrMany", "oneOrMany"]
              }
            }
          },
          "identifying": { "type": "boolean", "default": true }
        }
      },
      "mermaid": { "erDiagram": { "construct": "relationship" } }
    },

    "story.act": {
      "extends": "core.group",
      "label": "Act",
      "category": "story",
      "component": "StoryActNode",
      "icon": "folder",
      "allowsChildren": true,
      "allowedChildTypes": ["story.scene", "story.split", "story.act", "core.portal"],
      "$comment": "An Act is simply a node with children (D4). Nothing container-specific was required. Remove story.act from allowedChildTypes if the domain forbids nesting Acts — that is a registry rule, not a core constraint.",
      "dataSchema": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "targetWordCount": { "type": "integer", "minimum": 0 }
        }
      }
    },

    "story.scene": {
      "extends": "core.node",
      "label": "Scene",
      "category": "story",
      "component": "StorySceneNode",
      "icon": "file-text",
      "allowsChildren": true,
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": 1 } }
      },
      "$comment": "out.arity.max is 1, so connecting a second target triggers automatic story.split insertion.",
      "dataSchema": {
        "type": "object",
        "properties": {
          "synopsis": { "type": "string" },
          "prose": { "type": "string" },
          "characters": { "type": "array", "items": { "type": "string" } },
          "beats": { "type": "array", "items": { "type": "string" } },
          "wordCount": { "type": "integer", "minimum": 0 }
        }
      }
    },

    "story.split": {
      "extends": "core.branch",
      "label": "Path split",
      "category": "story",
      "component": "StorySplitNode",
      "icon": "git-branch",
      "allowsChildren": true,
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 1, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": null }, "group": true }
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "condition": { "type": "string" },
          "mode": {
            "type": "string",
            "enum": ["exclusive", "parallel"],
            "default": "exclusive",
            "description": "exclusive means the reader takes one path. parallel means concurrent threads, in which case rank between the branches is meaningless — see design doc open question 4."
          }
        }
      },
      "mermaid": { "flowchart": { "open": "{", "close": "}" } }
    }
  },

  "mermaidImport": {
    "$comment": "Table-driven so the importer contains no per-shape branching. shapeMatchOrder must be tried in array order: two-character delimiters before one-character, or '[[' is misread as '[' and the label keeps a stray bracket.",
    "flowchart": {
      "shapeMatchOrder": [
        { "open": "(((", "close": ")))", "type": "flow.terminal" },
        { "open": "[[",  "close": "]]",  "type": "flow.subroutine" },
        { "open": "[(",  "close": ")]",  "type": "flow.datastore" },
        { "open": "([",  "close": "])",  "type": "flow.terminal" },
        { "open": "[/",  "close": "/]",  "type": "flow.io" },
        { "open": "[\\", "close": "\\]", "type": "flow.io" },
        { "open": "[/",  "close": "\\]", "type": "flow.io" },
        { "open": "{{",  "close": "}}",  "type": "flow.process" },
        { "open": "((",  "close": "))",  "type": "flow.terminal" },
        { "open": "{",   "close": "}",   "type": "flow.decision" },
        { "open": "(",   "close": ")",   "type": "flow.rounded" },
        { "open": ">",   "close": "]",   "type": "flow.process" },
        { "open": "[",   "close": "]",   "type": "flow.process" }
      ],
      "edgeMatchOrder": [
        { "token": "~~~",  "line": "invisible", "arrowEnd": "none" },
        { "token": "-.->", "line": "dashed",    "arrowEnd": "arrow" },
        { "token": "-.-",  "line": "dashed",    "arrowEnd": "none" },
        { "token": "==>",  "line": "thick",     "arrowEnd": "arrow" },
        { "token": "===",  "line": "thick",     "arrowEnd": "none" },
        { "token": "-->",  "line": "solid",     "arrowEnd": "arrow" },
        { "token": "--o",  "line": "solid",     "arrowEnd": "circle" },
        { "token": "--x",  "line": "solid",     "arrowEnd": "cross" },
        { "token": "<-->", "line": "solid",     "arrowEnd": "arrow", "arrowStart": "arrow" },
        { "token": "---",  "line": "solid",     "arrowEnd": "none" }
      ],
      "directives": {
        "classDef": "ext:org.mermaid.style",
        "class": "ext:org.mermaid.style",
        "linkStyle": "ext:org.mermaid.style",
        "click": "ext:org.mermaid.interaction",
        "init": "ext:org.mermaid.config"
      }
    },
    "sequenceDiagram": {
      "arrowMatchOrder": [
        { "token": "-->>", "line": "dashed", "arrowEnd": "arrow" },
        { "token": "->>",  "line": "solid",  "arrowEnd": "arrow" },
        { "token": "--x",  "line": "dashed", "arrowEnd": "cross" },
        { "token": "-x",   "line": "solid",  "arrowEnd": "cross" },
        { "token": "--)",  "line": "dashed", "arrowEnd": "async" },
        { "token": "-)",   "line": "solid",  "arrowEnd": "async" },
        { "token": "-->",  "line": "dashed", "arrowEnd": "none" },
        { "token": "->",   "line": "solid",  "arrowEnd": "none" }
      ],
      "blockKeywords": ["alt", "else", "opt", "loop", "par", "and", "critical", "option", "break", "rect"]
    },
    "erDiagram": {
      "cardinalityLeft": {
        "||": "one",
        "|o": "zeroOrOne",
        "}o": "zeroOrMany",
        "}|": "oneOrMany"
      },
      "cardinalityRight": {
        "||": "one",
        "o|": "zeroOrOne",
        "o{": "zeroOrMany",
        "|{": "oneOrMany"
      },
      "identifying": { "--": true, "..": false }
    }
  },

  "normalize": {
    "branchOnFanOut": false,
    "$comment": "Default off so an import never silently restructures the source graph. Offer branch insertion as an explicit user action instead.",
    "insertBoundaryPortals": true,
    "rekeyCollisions": true,
    "emitViewEntries": false
  }
}
