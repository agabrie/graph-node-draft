{
  "registryVersion": "1.0.0",
  "$comment": "Domain configuration only. Defines what a node type IS: its port topology, arity rules, containment rules, and the shape of its opaque data payload. The only place domain vocabulary is allowed to appear.",
  "$comment-scope": "Deliberately absent: any reference to a rendering technology, component name, icon set, colour, shape, or layout hint. Those are consumer concerns and belong in a separate binding file owned by whichever presentation layer is in use, keyed by the same type names. This file must be usable by a backend with no renderer present at all.",
  "$comment-mermaid": "Also absent: the Mermaid bracket, arrow and cardinality tables. Those are import-adapter data, not domain configuration — see mermaid-import.map.json. Same reasoning: the domain does not know that Mermaid exists.",

  "rulesets": {
    "flowchart": {
      "invariants": ["INV-5"],
      "allowedTypes": ["flow.*", "core.*"],
      "defaultNodeType": "flow.process",
      "defaultEdgeType": "flow.link"
    },
    "sequence": {
      "invariants": ["INV-9"],
      "allowedTypes": ["seq.*", "core.group"],
      "defaultNodeType": "seq.participant",
      "defaultEdgeType": "seq.message",
      "$comment": "INV-5 deliberately absent: messages inside an alt block connect top-level participants, so edges are not level-local here."
    },
    "er": {
      "invariants": ["INV-10"],
      "allowedTypes": ["er.*", "core.group"],
      "defaultNodeType": "er.entity",
      "defaultEdgeType": "er.relationship"
    },
    "story": {
      "invariants": ["INV-5"],
      "allowedTypes": ["story.*", "core.*"],
      "defaultNodeType": "story.scene",
      "defaultEdgeType": "core.link"
    },
    "generic": {
      "invariants": [],
      "allowedTypes": ["*"],
      "defaultNodeType": "core.node",
      "defaultEdgeType": "core.link"
    }
  },

  "nodeTypes": {

    "core.node": {
      "abstract": true,
      "label": "Node",
      "category": "core",
      "allowsChildren": true,
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": null } }
      },
      "dataSchema": { "type": "object" }
    },

    "core.group": {
      "extends": "core.node",
      "label": "Group",
      "category": "core",
      "allowsChildren": true,
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": null } }
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "layout": {
            "type": "object",
            "$comment": "A layout preference carried as opaque payload for consumers that want it. The domain never reads it.",
            "properties": {
              "direction": { "type": "string", "enum": ["TB", "TD", "BT", "LR", "RL"] }
            }
          }
        }
      }
    },

    "core.portal": {
      "extends": "core.node",
      "label": "Portal",
      "category": "core",
      "allowsChildren": false,
      "$comment": "Binds an interior endpoint to a port on its own parent, so no edge ever crosses a containment boundary (INV-5). Created by the import adapter during normalisation; optionally user-creatable.",
      "ports": {
        "link": { "direction": "inout", "role": "portal", "arity": { "min": 0, "max": 1 } }
      },
      "dataSchema": {
        "type": "object",
        "required": ["port", "direction"],
        "properties": {
          "port": { "type": "string", "description": "Port id on the parent node that this portal binds to." },
          "direction": { "type": "string", "enum": ["in", "out"] }
        }
      }
    },

    "core.branch": {
      "extends": "core.node",
      "label": "Branch",
      "category": "core",
      "allowsChildren": true,
      "$comment": "Inserted when a second edge is connected to an out-port whose arity.max is 1. Because allowsChildren is true it is already a subgraph the moment it is expanded — no conversion step, no id churn. `origin` governs auto-collapse: an editor-inserted branch that stops branching is removed again; an authored one never is. See design doc 8.1.",
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 1, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": null }, "group": true }
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "condition": { "type": "string" },
          "origin": {
            "type": "string",
            "enum": ["auto", "authored"],
            "default": "authored",
            "description": "auto means the editor inserted this to satisfy an arity rule, so it may be collapsed silently when it stops branching. authored means the user placed it and it is never auto-removed. Default is authored: anything that does not declare itself is treated as content."
          }
        }
      }
    },

    "core.link": {
      "edge": true,
      "label": "Link",
      "category": "core",
      "style": { "line": "solid", "arrowEnd": "arrow" },
      "dataSchema": { "type": "object" }
    },

    "flow.process": {
      "extends": "core.node",
      "label": "Process",
      "category": "flowchart",
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": 1 } }
      }
    },

    "flow.rounded": {
      "extends": "flow.process",
      "label": "Rounded process",
      "category": "flowchart"
    },

    "flow.terminal": {
      "extends": "core.node",
      "label": "Terminal",
      "category": "flowchart",
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": 1 } }
      }
    },

    "flow.decision": {
      "extends": "core.node",
      "label": "Decision",
      "category": "flowchart",
      "ports": {
        "in":    { "direction": "in",  "arity": { "min": 1, "max": null } },
        "true":  { "direction": "out", "role": "true",  "arity": { "min": 0, "max": 1 } },
        "false": { "direction": "out", "role": "false", "arity": { "min": 0, "max": 1 } }
      },
      "dataSchema": {
        "type": "object",
        "properties": { "expression": { "type": "string" } }
      }
    },

    "flow.datastore": {
      "extends": "core.node",
      "label": "Datastore",
      "category": "flowchart",
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": null } }
      }
    },

    "flow.subroutine": {
      "extends": "flow.process",
      "label": "Subroutine",
      "category": "flowchart"
    },

    "flow.io": {
      "extends": "flow.process",
      "label": "Input / output",
      "category": "flowchart"
    },

    "flow.link": {
      "edge": true,
      "label": "Link",
      "category": "flowchart",
      "style": { "line": "solid", "arrowEnd": "arrow" },
      "dataSchema": { "type": "object" }
    },

    "seq.participant": {
      "extends": "core.node",
      "label": "Participant",
      "category": "sequence",
      "allowsChildren": false,
      "ports": {
        "lane": { "direction": "inout", "arity": { "min": 0, "max": null } }
      },
      "dataSchema": {
        "type": "object",
        "properties": { "isActor": { "type": "boolean", "default": false } }
      }
    },

    "seq.actor": {
      "extends": "seq.participant",
      "label": "Actor",
      "category": "sequence"
    },

    "seq.block": {
      "extends": "core.group",
      "label": "Block",
      "category": "sequence",
      "allowsChildren": true,
      "$comment": "Children are edges, not nodes. Needed no new machinery because containment is uniform across both collections. Note the INV-7 consequence: a purge guard that counts only node children will wrongly report this as purgeable.",
      "dataSchema": {
        "type": "object",
        "required": ["blockType"],
        "properties": {
          "blockType": {
            "type": "string",
            "enum": ["alt", "opt", "loop", "par", "critical", "break", "rect"]
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "edgeIds": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },

    "seq.note": {
      "extends": "core.node",
      "label": "Note",
      "category": "sequence",
      "allowsChildren": false,
      "ports": {},
      "dataSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "placement": { "type": "string", "enum": ["left", "right", "over"] },
          "anchors": { "type": "array", "items": { "type": "string" }, "maxItems": 2 }
        }
      }
    },

    "seq.message": {
      "edge": true,
      "label": "Message",
      "category": "sequence",
      "style": { "line": "solid", "arrowEnd": "arrow" },
      "dataSchema": {
        "type": "object",
        "properties": {
          "activate": { "type": "boolean", "default": false },
          "deactivate": { "type": "boolean", "default": false }
        }
      }
    },

    "er.entity": {
      "extends": "core.node",
      "label": "Entity",
      "category": "er",
      "allowsChildren": false,
      "$comment": "Attributes live in data, not as child nodes, because they are not independently connectable. To wire FK to PK later, generate one instance port per attribute — data.attributes stays the source of truth, ports become the connection surface, no schema change needed.",
      "ports": {
        "rel": { "direction": "inout", "arity": { "min": 0, "max": null } }
      },
      "dataSchema": {
        "type": "object",
        "properties": {
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "keys": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["PK", "FK", "UK"] }
                },
                "comment": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "er.relationship": {
      "edge": true,
      "label": "Relationship",
      "category": "er",
      "style": { "line": "solid", "arrowEnd": "none" },
      "dataSchema": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "object",
            "required": ["cardinality"],
            "properties": {
              "cardinality": {
                "type": "string",
                "enum": ["one", "zeroOrOne", "zeroOrMany", "oneOrMany"]
              }
            }
          },
          "to": {
            "type": "object",
            "required": ["cardinality"],
            "properties": {
              "cardinality": {
                "type": "string",
                "enum": ["one", "zeroOrOne", "zeroOrMany", "oneOrMany"]
              }
            }
          },
          "identifying": { "type": "boolean", "default": true }
        }
      }
    },

    "story.act": {
      "extends": "core.group",
      "label": "Act",
      "category": "story",
      "allowsChildren": true,
      "allowedChildTypes": ["story.scene", "story.split", "story.act", "core.portal"],
      "$comment": "An Act is simply a node with children (D4). Nothing container-specific was required. Remove story.act from allowedChildTypes if the domain forbids nesting Acts — that is a registry rule, not a core constraint.",
      "dataSchema": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "targetWordCount": { "type": "integer", "minimum": 0 }
        }
      }
    },

    "story.scene": {
      "extends": "core.node",
      "label": "Scene",
      "category": "story",
      "allowsChildren": true,
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 0, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": 1 } }
      },
      "$comment": "out.arity.max is 1, so connecting a second target triggers automatic story.split insertion.",
      "dataSchema": {
        "type": "object",
        "properties": {
          "synopsis": { "type": "string" },
          "prose": { "type": "string" },
          "characters": { "type": "array", "items": { "type": "string" } },
          "beats": { "type": "array", "items": { "type": "string" } },
          "wordCount": { "type": "integer", "minimum": 0 }
        }
      }
    },

    "story.split": {
      "extends": "core.branch",
      "label": "Path split",
      "category": "story",
      "allowsChildren": true,
      "ports": {
        "in":  { "direction": "in",  "arity": { "min": 1, "max": null } },
        "out": { "direction": "out", "arity": { "min": 0, "max": null }, "group": true }
      },
      "$comment-dataSchema": "dataSchema does NOT merge along the extends chain — each type declares its complete payload shape. `origin` is therefore repeated from core.branch rather than inherited. Ports do merge; dataSchema deliberately does not, so a subtype can narrow its parent's payload rather than only widen it.",
      "dataSchema": {
        "type": "object",
        "properties": {
          "condition": { "type": "string" },
          "mode": {
            "type": "string",
            "enum": ["exclusive", "parallel"],
            "default": "exclusive",
            "description": "exclusive means one path is taken. parallel means concurrent threads, in which case rank between the branches is meaningless — see design doc open question 4."
          },
          "origin": {
            "type": "string",
            "enum": ["auto", "authored"],
            "default": "authored",
            "description": "See core.branch. Governs whether this split is collapsed automatically when it stops branching."
          }
        }
      }
    }
  },

  "normalize": {
    "branchOnFanOut": false,
    "$comment": "Default off so an import never silently restructures the source graph. Offer branch insertion as an explicit user action instead.",
    "insertBoundaryPortals": true,
    "rekeyCollisions": true
  }
}
