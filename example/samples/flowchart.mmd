flowchart LR
  start([Request received]) --> validate[Validate payload]
  validate --> decide{Valid?}
  decide -->|no| reject[/Reject notice/]
  decide -->|yes| enrich[[Enrich record]]
  subgraph core [Core services]
    orders[Order service] --> payments[Payment service]
  end
  enrich --> orders
  payments --> db[(Postgres)]
  reject --> db
